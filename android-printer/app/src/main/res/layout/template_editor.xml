<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logo scale (multiplier)"
            android:textColor="@color/cream"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_logo_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="1.0"
            android:textColor="@color/cream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Logo Y offset (mm)"
            android:textColor="@color/cream"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_logo_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.0"
            android:textColor="@color/cream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Name Y offset (mm)"
            android:textColor="@color/cream"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_name_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.0"
            android:textColor="@color/cream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Name font multiplier"
            android:textColor="@color/cream"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_name_font_mult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="1.0"
            android:textColor="@color/cream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Role Y offset (mm)"
            android:textColor="@color/cream"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_role_y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="0.0"
            android:textColor="@color/cream" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Role font multiplier"
            android:textColor="@color/cream"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_role_font_mult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="1.0"
            android:textColor="@color/cream" />

    </LinearLayout>
</ScrollView>

