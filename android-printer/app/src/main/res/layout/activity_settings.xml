<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/settings"
        android:textColor="@color/cream"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/settings_hint"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn_accent"
        android:text="@string/connect"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/print_test"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnEditTemplate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/edit_template"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnSetServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/set_server"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/disconnect"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_panel"
        android:text="@string/back"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />
</LinearLayout>
