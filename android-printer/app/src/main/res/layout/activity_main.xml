<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/brand"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/status_disconnected"
        android:textColor="@color/cream"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_size"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/previewImage"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="18dp"
        android:contentDescription="@string/label_size"
        android:scaleType="fitCenter" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/hint_pair"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn_accent"
        android:text="@string/connect"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnTest"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/print_test"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnEditTemplate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/edit_template"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnSetServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/set_server"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />

    <Button
        android:id="@+id/btnDisconnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_panel"
        android:text="@string/disconnect"
        android:textAllCaps="false"
        android:textColor="@color/cream"
        android:textSize="17sp" />
</LinearLayout>
