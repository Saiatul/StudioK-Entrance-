<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Badge Template Editor"
        android:textColor="@color/accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Drag to move · Corner handle to resize"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <!-- The drag-and-drop canvas (50×20mm scaled to fit) -->
    <dev.studiok.printer.LabelCanvasView
        android:id="@+id/labelCanvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@color/panel" />

    <!-- Properties of selected element -->
    <LinearLayout
        android:id="@+id/propsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Font size (mm)"
                android:textColor="@color/cream"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etFontSize"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/cream"
                android:textSize="13sp"
                android:hint="5.0" />

            <Button
                android:id="@+id/btnApplyFont"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Apply"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:backgroundTint="@color/accent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_panel"
            android:text="Reset"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_accent"
            android:text="Save Template"
            android:textAllCaps="false"
            android:textColor="@color/cream"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
